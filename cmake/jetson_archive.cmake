# Extract into the package build tree once per archive revision.
function(dozer_extract_jetson_archive filename destination)
  if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
    message(FATAL_ERROR "The bundled Jetson dependencies require Linux aarch64")
  endif()
  set(archive "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../vendor/jetson/${filename}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${archive}")
  file(SHA256 "${archive}" digest)
  set(output "${CMAKE_CURRENT_BINARY_DIR}/deps/${digest}")
  if(NOT EXISTS "${output}/.complete")
    file(MAKE_DIRECTORY "${output}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${output}")
    file(TOUCH "${output}/.complete")
  endif()
  set(${destination} "${output}" PARENT_SCOPE)
endfunction()
